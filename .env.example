# Supabase (required for profile/player APIs and build-time data collection)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth (optional; enables Discord login)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
AUTH_SECRET=your-auth-secret
NEXTAUTH_SECRET=your-nextauth-secret

# Optional: Cloudflare R2 cache for pre-rendered OG images
OG_R2_ACCOUNT_ID=your-r2-account-id
OG_R2_BUCKET=your-r2-bucket-name
OG_R2_ACCESS_KEY_ID=your-r2-access-key-id
OG_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
